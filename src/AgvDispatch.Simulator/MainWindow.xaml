<hc:Window x:Class="AgvDispatch.Simulator.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:local="clr-namespace:AgvDispatch.Simulator"
           xmlns:controls="clr-namespace:AgvDispatch.Simulator.Controls"
           mc:Ignorable="d"
           Title="AGV 模拟器 (VDA5050 v2.0.0)" Height="880" Width="1420"
           MinHeight="760" MinWidth="1180"
           WindowStartupLocation="CenterScreen"
           NonClientAreaHeight="36"
           ShowNonClientArea="True">

    <hc:Window.NonClientAreaContent>
        <Grid Height="36" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="AGV 模拟器" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text=" - " VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding SerialNumber, StringFormat='设备编号: {0}'}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text=" (VDA5050 v2.0.0)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TertiaryTextBrush}" Margin="4,0,0,0"/>
            </StackPanel>
        </Grid>
    </hc:Window.NonClientAreaContent>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：连接与设备身份配置 -->
        <hc:Card Grid.Row="0" Margin="0,0,0,10" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="连接与设备配置" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <hc:Divider LineStroke="{DynamicResource BorderBrush}" Margin="12,0,12,0"/>
                    <TextBlock Text="通信规范: VDA5050 §3, §5, §11" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="主机 (IP):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="端口:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="制造商:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <TextBlock Text="序列号:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,24,0" VerticalAlignment="Center"/>

                    <Button Content="连接 (Connect)" Command="{Binding ConnectCommand}" Style="{StaticResource ButtonPrimary}" Width="110" Height="30" Margin="0,0,10,0"/>
                    <Button Content="断开 (Disconnect)" Command="{Binding DisconnectCommand}" Style="{StaticResource ButtonDefault}" Width="120" Height="30" Margin="0,0,24,0"/>

                    <TextBlock Text="连接状态: " VerticalAlignment="Center" FontWeight="Bold"/>
                    <hc:Tag Content="{Binding ConnectionStateDisplay}" VerticalAlignment="Center" FontWeight="Bold">
                        <hc:Tag.Style>
                            <Style TargetType="hc:Tag" BasedOn="{StaticResource TagBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="ONLINE">
                                        <Setter Property="Background" Value="#E6F7ED"/>
                                        <Setter Property="Foreground" Value="#2DA641"/>
                                        <Setter Property="BorderBrush" Value="#57C172"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="CONNECTIONBROKEN">
                                        <Setter Property="Background" Value="#FEECEB"/>
                                        <Setter Property="Foreground" Value="#EB3323"/>
                                        <Setter Property="BorderBrush" Value="#F56C6C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="OFFLINE">
                                        <Setter Property="Background" Value="#F4F4F5"/>
                                        <Setter Property="Foreground" Value="#909399"/>
                                        <Setter Property="BorderBrush" Value="#D3D4D6"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:Tag.Style>
                    </hc:Tag>
                </WrapPanel>
            </Grid>
        </hc:Card>

        <!-- 主工作区：左侧实时地图与协议事件流，右侧状态看板与详情 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：实时地图 + 订单收发协议事件 -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="230"/>
                </Grid.RowDefinitions>

                <!-- 1. 实时地图看板 -->
                <hc:Card Grid.Row="0" Margin="0,0,0,10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 地图顶部工具条 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="AGV 实时运行地图" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0">
                                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding PositionX, StringFormat='X: {0:F2} m'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding PositionY, StringFormat='Y: {0:F2} m'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding PositionTheta, StringFormat='θ: {0:F2} rad'}" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </Border>
                                <Border Background="{DynamicResource SecondaryRegionBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding TrailPoints.Count, StringFormat='轨迹点数: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="清除轨迹" Command="{Binding ClearTrailCommand}" Style="{StaticResource ButtonDefault}" Height="26" FontSize="11" Padding="10,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 地图画布 -->
                        <Border Grid.Row="1" CornerRadius="4" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <controls:SimMapCanvas
                                WaypointsSource="{Binding Waypoints}"
                                TrailSource="{Binding TrailPoints}"
                                AgvX="{Binding PositionX}"
                                AgvY="{Binding PositionY}"
                                AgvTheta="{Binding PositionTheta}"
                                AgvBatteryCharge="{Binding BatteryCharge}"
                                IsDriving="{Binding Driving}"
                                IsPaused="{Binding Paused}"
                                HasFatalError="{Binding HasFatalError}"
                                AgvSerialNumber="{Binding SerialNumber}"/>
                        </Border>
                    </Grid>
                </hc:Card>

                <!-- 2. 订单收发与协议事件流 -->
                <hc:Card Grid.Row="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="订单收发与协议事件流 (Protocol Events)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="记录收到订单、即时动作、状态上报与订单完成等核心事件" FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                            <Button Grid.Column="2" Content="清空事件" Command="{Binding ClearProtocolLogsCommand}" Style="{StaticResource ButtonDefault}" Height="24" FontSize="11" Padding="8,0"/>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding ProtocolLogs}" FontFamily="Consolas, Microsoft YaHei" FontSize="11"/>
                    </Grid>
                </hc:Card>
            </Grid>

            <!-- 右侧：状态看板与详情（订单/运动/电量/门禁 + 动作/错误/系统日志） -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 2x2 状态卡片看板 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. 当前订单 -->
                    <hc:Card Grid.Row="0" Grid.Column="0" Margin="0,0,5,6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="当前订单 (Order)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <hc:Divider Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding OrderId, StringFormat='订单编号: {0}'}" FontSize="11" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding OrderUpdateId, StringFormat='更新批次: {0}'}" FontSize="11" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding LastNodeId, StringFormat='最后节点: {0}'}" FontSize="11" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding LastNodeSequenceId, StringFormat='最后序号: {0}'}" FontSize="11" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding NodeStatesCount, StringFormat='剩余节点数: {0}'}" FontSize="11" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding EdgeStatesCount, StringFormat='剩余边线数: {0}'}" FontSize="11" Margin="0,1,0,1"/>
                        </StackPanel>
                    </hc:Card>

                    <!-- 2. 运动学与位置 -->
                    <hc:Card Grid.Row="0" Grid.Column="1" Margin="5,0,0,6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="运动学与位置 (Kinematics)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <hc:Divider Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding PositionX, StringFormat='X 坐标: {0:F3} m'}" FontSize="11" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding PositionY, StringFormat='Y 坐标: {0:F3} m'}" FontSize="11" Margin="0,1,0,1"/>
                            <TextBlock Text="{Binding PositionTheta, StringFormat='航向角 θ: {0:F3} rad'}" FontSize="11" Margin="0,1,0,1"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,2">
                                <TextBlock Text="移动: " FontSize="11" VerticalAlignment="Center"/>
                                <hc:Tag Content="{Binding DrivingDisplay}" VerticalAlignment="Center" FontSize="10">
                                    <hc:Tag.Style>
                                        <Style TargetType="hc:Tag" BasedOn="{StaticResource TagBaseStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Driving}" Value="True">
                                                    <Setter Property="Background" Value="#E6F7ED"/>
                                                    <Setter Property="Foreground" Value="#2DA641"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Driving}" Value="False">
                                                    <Setter Property="Background" Value="#F4F4F5"/>
                                                    <Setter Property="Foreground" Value="#909399"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:Tag.Style>
                                </hc:Tag>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,1">
                                <TextBlock Text="暂停: " FontSize="11" VerticalAlignment="Center"/>
                                <hc:Tag Content="{Binding PausedDisplay}" VerticalAlignment="Center" FontSize="10">
                                    <hc:Tag.Style>
                                        <Style TargetType="hc:Tag" BasedOn="{StaticResource TagBaseStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Paused}" Value="True">
                                                    <Setter Property="Background" Value="#FFF7E6"/>
                                                    <Setter Property="Foreground" Value="#FA8C16"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Paused}" Value="False">
                                                    <Setter Property="Background" Value="#E6F7ED"/>
                                                    <Setter Property="Foreground" Value="#2DA641"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:Tag.Style>
                                </hc:Tag>
                            </StackPanel>
                        </StackPanel>
                    </hc:Card>

                    <!-- 3. 电池与模式 -->
                    <hc:Card Grid.Row="1" Grid.Column="0" Margin="0,6,5,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="电池与模式 (Power &amp; Mode)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <hc:Divider Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding BatteryCharge, StringFormat='剩余电量: {0:F1} %'}" FontSize="11" Margin="0,1,0,1"/>
                            <ProgressBar Value="{Binding BatteryCharge}" Maximum="100" Height="10" Margin="0,2,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="充电: " FontSize="11" VerticalAlignment="Center"/>
                                <hc:Tag Content="{Binding ChargingDisplay}" VerticalAlignment="Center" FontSize="10">
                                    <hc:Tag.Style>
                                        <Style TargetType="hc:Tag" BasedOn="{StaticResource TagBaseStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Charging}" Value="True">
                                                    <Setter Property="Background" Value="#E6F7FF"/>
                                                    <Setter Property="Foreground" Value="#1890FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Charging}" Value="False">
                                                    <Setter Property="Background" Value="#F4F4F5"/>
                                                    <Setter Property="Foreground" Value="#909399"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:Tag.Style>
                                </hc:Tag>
                            </StackPanel>
                            <TextBlock Text="{Binding OperatingModeDisplay, StringFormat='模式: {0}'}" FontSize="11" Margin="0,2,0,1"/>
                        </StackPanel>
                    </hc:Card>

                    <!-- 4. 故障注入门禁 -->
                    <hc:Card Grid.Row="1" Grid.Column="1" Margin="5,6,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="故障注入门禁 (§15)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <hc:Divider Margin="0,0,0,6"/>
                            <Button Content="注入警告 (WARNING)" Command="{Binding InjectWarningCommand}" Style="{StaticResource ButtonWarning}" Height="26" FontSize="11" Margin="0,0,0,4"/>
                            <Button Content="注入致命错误 (FATAL)" Command="{Binding InjectFatalCommand}" Style="{StaticResource ButtonDanger}" Height="26" FontSize="11" Margin="0,0,0,4"/>
                            <Button Content="清除所有错误" Command="{Binding ClearErrorsCommand}" Style="{StaticResource ButtonSuccess}" Height="26" FontSize="11"/>
                        </StackPanel>
                    </hc:Card>
                </Grid>

                <!-- 选项卡：动作状态 / 错误列表 / 系统底层日志 -->
                <hc:Card Grid.Row="1" Padding="10">
                    <TabControl Style="{StaticResource TabControlInLine}">
                        <!-- Tab 1: 动作状态 -->
                        <TabItem Header="动作状态 (ActionStates)">
                            <DataGrid ItemsSource="{Binding ActionStates}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="动作ID" Binding="{Binding ActionId}" Width="110"/>
                                    <DataGridTextColumn Header="动作类型" Binding="{Binding ActionType}" Width="100"/>
                                    <DataGridTextColumn Header="执行状态" Binding="{Binding ActionStatus}" Width="90"/>
                                    <DataGridTextColumn Header="描述/执行结果" Binding="{Binding ResultDescription}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- Tab 2: 错误列表 -->
                        <TabItem Header="错误与报警 (Errors)">
                            <DataGrid ItemsSource="{Binding Errors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="级别" Binding="{Binding ErrorLevel}" Width="80"/>
                                    <DataGridTextColumn Header="错误类型" Binding="{Binding ErrorType}" Width="130"/>
                                    <DataGridTextColumn Header="错误描述" Binding="{Binding ErrorDescription}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- Tab 3: 系统底层日志 -->
                        <TabItem Header="系统底层日志 (System Logs)">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Content="清空日志" Command="{Binding ClearLogsCommand}" Style="{StaticResource ButtonDefault}" Height="24" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" FontFamily="Consolas, Microsoft YaHei" FontSize="11"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </hc:Card>
            </Grid>
        </Grid>
    </Grid>
</hc:Window>
