<hc:Window x:Class="AgvDispatch.MasterControl.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:controls="clr-namespace:AgvDispatch.MasterControl.Controls"
           xmlns:vm="clr-namespace:AgvDispatch.MasterControl.ViewModels"
           mc:Ignorable="d"
           Title="AGV 调度主控系统 [VDA5050 v2.0.0]"
           Height="880" Width="1380"
           MinHeight="650" MinWidth="1050"
           NonClientAreaHeight="38"
           Background="#131722"
           Foreground="#E2E8F0">

    <hc:Window.NonClientAreaContent>
        <Grid Height="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Brand & Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="AGV 调度主控" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                <Border Background="#0284C7" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="VDA5050 v2.0.0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>

            <!-- Status Indicator in Titlebar -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="6,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="#22C55E"/>
                        <TextBlock Text="{Binding BrokerStatusText}" FontSize="11" Foreground="#CBD5E1"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="6,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="#22C55E"/>
                        <TextBlock Text="{Binding ClientStatusText}" FontSize="11" Foreground="#CBD5E1"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </hc:Window.NonClientAreaContent>

    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A3042"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181E2A"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="RowBackground" Value="#181E2A"/>
            <Setter Property="AlternatingRowBackground" Value="#1E2535"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2D3748"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Body: Tabs on Left, AGV Fleet List on Right -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left Tab Panels -->
            <TabControl Grid.Column="0" Background="#131722" BorderThickness="0" Margin="4">
                <!-- Tab 1: 实时地图 -->
                <TabItem Header="实时地图">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Custom Map Canvas -->
                        <Border Grid.Row="0" Background="#181C24" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                            <controls:MapCanvas x:Name="LiveMapCanvas"
                                                AgvsSource="{Binding Map.Agvs}"
                                                PlannedWaypointsSource="{Binding Map.PlannedWaypoints}"
                                                SelectedAgv="{Binding Map.SelectedAgv}"
                                                MapClicked="LiveMapCanvas_MapClicked"/>
                        </Border>

                        <!-- Map Toolbar & Quick Actions -->
                        <Border Grid.Row="1" Background="#1E293B" CornerRadius="4" Padding="12,8" Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="提示：在地图上任意点击可直接放置路径点。" FontSize="12" Foreground="#94A3B8"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="目标 AGV:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding AgvList.SelectedAgv.SerialNumber, FallbackValue='(未选择)'}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button Content="暂停" Style="{StaticResource ButtonDefault}" Command="{Binding AgvList.StartPauseCommand}" Margin="0,0,6,0"/>
                                    <Button Content="恢复" Style="{StaticResource ButtonDefault}" Command="{Binding AgvList.StopPauseCommand}" Margin="0,0,6,0"/>
                                    <Button Content="取消订单" Style="{StaticResource ButtonDanger}" Command="{Binding AgvList.CancelOrderCommand}" Margin="0,0,6,0"/>
                                    <Button Content="请求参数 (Factsheet)" Style="{StaticResource ButtonDefault}" Command="{Binding AgvList.RequestFactsheetCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: 订单编辑 -->
                <TabItem Header="订单编辑 (§12b, §9)">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Order Config on Left -->
                        <hc:Card Grid.Column="0" Background="#181E2A" BorderBrush="#334155" Padding="12" Margin="0,0,6,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="订单配置" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                    <TextBlock Text="目标 AGV:" Margin="0,4,0,2" Foreground="#94A3B8"/>
                                    <ComboBox ItemsSource="{Binding OrderEditor.AvailableAgvs}"
                                              SelectedItem="{Binding OrderEditor.SelectedAgv}"
                                              DisplayMemberPath="SerialNumber"
                                              Background="#1E293B" Foreground="#F8FAFC" Padding="6,4"/>

                                    <TextBlock Text="订单编号 (Order ID):" Margin="0,10,0,2" Foreground="#94A3B8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding OrderEditor.OrderId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="生成" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.GenerateNewOrderIdCommand}" Margin="4,0,0,0"/>
                                    </Grid>

                                    <TextBlock Text="已释放基准大小 (Horizon 远景模型 §12b):" Margin="0,10,0,2" Foreground="#94A3B8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="2" Maximum="10" Value="{Binding OrderEditor.BaseSize}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OrderEditor.BaseSize}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="前 N 个节点 released=true (基准 Base ≥ 2)，其余为远景 Horizon。AGV 接近基准末端时请求拼接拓展。" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,8"/>

                                    <TextBlock Text="预设路线:" Margin="0,8,0,4" Foreground="#94A3B8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="直线路线" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.LoadPresetLineCommand}" Margin="0,0,6,0"/>
                                        <Button Content="方形路线" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.LoadPresetSquareCommand}" Margin="0,0,6,0"/>
                                        <Button Content="清空" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.ClearWaypointsCommand}"/>
                                    </StackPanel>

                                    <TextBlock Text="添加路径点 (X, Y 坐标，单位米):" Margin="0,8,0,2" Foreground="#94A3B8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding OrderEditor.NewWaypointX}" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding OrderEditor.NewWaypointY}" Margin="0,0,4,0"/>
                                        <Button Grid.Column="2" Content="添加" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.AddWaypointCommand}"/>
                                    </Grid>

                                    <Border Background="#1E293B" CornerRadius="4" Padding="8" Margin="0,10,0,10">
                                        <StackPanel>
                                            <TextBlock Text="校验结果:" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding OrderEditor.ValidationStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Dispatch Action -->
                                    <Button Content="下发订单 (§12b)" Style="{StaticResource ButtonPrimary}" Command="{Binding OrderEditor.DispatchOrderCommand}" FontSize="14" Height="36" Margin="0,4,0,8"/>

                                    <TextBlock Text="即时动作 (§10, §13):" Margin="0,10,0,4" Foreground="#94A3B8"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="暂停" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.StartPauseCommand}" Margin="0,0,4,4"/>
                                        <Button Content="恢复" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.StopPauseCommand}" Margin="0,0,4,4"/>
                                        <Button Content="取消订单 (§13)" Style="{StaticResource ButtonDanger}" Command="{Binding OrderEditor.CancelOrderCommand}" Margin="0,0,4,4"/>
                                        <Button Content="请求参数" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.RequestFactsheetCommand}" Margin="0,0,4,4"/>
                                        <Button Content="请求状态" Style="{StaticResource ButtonDefault}" Command="{Binding OrderEditor.RequestStateCommand}" Margin="0,0,4,4"/>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding OrderEditor.DispatchStatusMessage}" TextWrapping="Wrap" Foreground="#38BDF8" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </hc:Card>

                        <!-- Waypoints Table on Right -->
                        <hc:Card Grid.Column="1" Background="#181E2A" BorderBrush="#334155" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="规划路径序列 (交替规则：节点偶数 / 边奇数递增)" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding OrderEditor.Waypoints}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="节点编号" Binding="{Binding NodeId}" Width="120"/>
                                        <DataGridTextColumn Header="X 坐标 (m)" Binding="{Binding X}" Width="90"/>
                                        <DataGridTextColumn Header="Y 坐标 (m)" Binding="{Binding Y}" Width="90"/>
                                        <DataGridCheckBoxColumn Header="已释放 (Base)" Binding="{Binding IsReleased}" Width="110"/>
                                        <DataGridTemplateColumn Header="操作" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="删除" Style="{StaticResource ButtonDanger}" Command="{Binding DataContext.OrderEditor.RemoveWaypointCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="6,2" FontSize="11"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </hc:Card>
                    </Grid>
                </TabItem>

                <!-- Tab 3: 报文监控 -->
                <TabItem Header="报文监控 (§20)">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filter Bar -->
                        <Border Grid.Row="0" Background="#181E2A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="过滤搜索:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding MqttMonitor.FilterText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="报文方向:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <ComboBox Grid.Column="3" ItemsSource="{Binding MqttMonitor.DirectionOptions}" SelectedItem="{Binding MqttMonitor.SelectedDirection}" Background="#1E293B" Foreground="#F8FAFC" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <TextBlock Text="累计捕获: " Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MqttMonitor.TotalCaptured}" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="清空记录" Style="{StaticResource ButtonDefault}" Command="{Binding MqttMonitor.ClearCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Monitor DataGrid (Bounded to 500 items §20) -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding MqttMonitor.LogEntries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间 (UTC)" Binding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss.fff\}}" Width="120"/>
                                <DataGridTextColumn Header="方向" Binding="{Binding DirectionDisplay}" Width="110"/>
                                <DataGridTextColumn Header="主题 (Topic)" Binding="{Binding Topic}" Width="260"/>
                                <DataGridTextColumn Header="客户端标识" Binding="{Binding ClientId}" Width="120"/>
                                <DataGridTextColumn Header="载荷数据 (JSON)" Binding="{Binding PayloadJson}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 4: 任务记录 -->
                <TabItem Header="任务记录 (§18)">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#181E2A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SQLite 任务审计记录 (WAL 模式, §18)" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <Button Content="刷新记录" Style="{StaticResource ButtonDefault}" Command="{Binding TaskHistory.RefreshCommand}" Margin="16,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Orders Table -->
                        <GroupBox Grid.Row="1" Header="历史订单表 (orders)" Foreground="#94A3B8" Margin="0,0,0,6">
                            <DataGrid ItemsSource="{Binding TaskHistory.Orders}" SelectedItem="{Binding TaskHistory.SelectedOrder}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="订单编号" Binding="{Binding OrderId}" Width="180"/>
                                    <DataGridTextColumn Header="AGV序列号" Binding="{Binding AgvSerial}" Width="100"/>
                                    <DataGridTextColumn Header="更新批次" Binding="{Binding OrderUpdateId}" Width="80"/>
                                    <DataGridTextColumn Header="执行状态" Binding="{Binding Status}" Width="110"/>
                                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="170"/>
                                    <DataGridTextColumn Header="下发时间" Binding="{Binding DispatchedAt}" Width="170"/>
                                    <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Order Events Table -->
                        <GroupBox Grid.Row="2" Header="订单状态事件跟踪 (order_events)" Foreground="#94A3B8">
                            <DataGrid ItemsSource="{Binding TaskHistory.OrderEvents}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="序号" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="订单编号" Binding="{Binding OrderId}" Width="160"/>
                                    <DataGridTextColumn Header="AGV" Binding="{Binding AgvSerial}" Width="90"/>
                                    <DataGridTextColumn Header="事件类型" Binding="{Binding EventType}" Width="120"/>
                                    <DataGridTextColumn Header="事件时间" Binding="{Binding Ts}" Width="170"/>
                                    <DataGridTextColumn Header="载荷数据" Binding="{Binding PayloadJson}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Right Column: AGV Fleet Registry Panel -->
            <Border Grid.Column="1" Background="#181E2A" BorderBrush="#334155" BorderThickness="1,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="AGV 注册表 (§11)" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="跟踪在线/离线/连接断开与健康状态" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <!-- AGVs List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding AgvList.Agvs}" SelectedItem="{Binding AgvList.SelectedAgv}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="4" Padding="10" Margin="0,0,0,6" BorderThickness="1" BorderBrush="#334155">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding SerialNumber}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                <TextBlock Text="{Binding Manufacturer, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#0F172A" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="{Binding ConnectionStateDisplay}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding BatteryCharge, StringFormat='电量: {0:F0}%'}" FontSize="11" Foreground="#E2E8F0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OperatingModeDisplay}" FontSize="11" Foreground="#E2E8F0" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding OrderId, StringFormat='订单: {0}'}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Driving, StringFormat='运行中: {0}'}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Error banner if any -->
                                        <Border Visibility="{Binding HasFatalError, Converter={StaticResource BoolToVis}}" Background="#7F1D1D" CornerRadius="2" Padding="4,2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ErrorSummary}" FontSize="10" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Selected AGV Details & Actions Panel -->
                    <hc:Card Grid.Row="2" Background="#0F172A" BorderBrush="#334155" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="选中 AGV 控制面板" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AgvList.SelectedAgv.SerialNumber, StringFormat='序列号: {0}', FallbackValue='未选中 AGV'}" Foreground="White" Margin="0,0,0,4"/>

                            <WrapPanel Margin="0,4,0,4">
                                <Button Content="暂停" Style="{StaticResource ButtonDefault}" Command="{Binding AgvList.StartPauseCommand}" Margin="0,0,4,4"/>
                                <Button Content="恢复" Style="{StaticResource ButtonDefault}" Command="{Binding AgvList.StopPauseCommand}" Margin="0,0,4,4"/>
                                <Button Content="取消订单" Style="{StaticResource ButtonDanger}" Command="{Binding AgvList.CancelOrderCommand}" Margin="0,0,4,4"/>
                                <Button Content="请求参数" Style="{StaticResource ButtonDefault}" Command="{Binding AgvList.RequestFactsheetCommand}" Margin="0,0,4,4"/>
                                <Button Content="请求状态" Style="{StaticResource ButtonDefault}" Command="{Binding AgvList.RequestStateCommand}" Margin="0,0,4,4"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding AgvList.ActionStatusMessage}" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </hc:Card>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SystemStatusMessage}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="调度系统运行中" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
